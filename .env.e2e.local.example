# e2e harness config — copy to .env.e2e.local and fill in.
#
# There are NO SECRETS in this file, by design. If you find yourself adding a
# FIREBASE_ADMIN_PRIVATE_KEY here, stop: the harness rejects it on purpose.
# See scripts/e2e/README.md for the harness.

# Must be an allowlisted origin (see scripts/e2e/lib/env.mjs). Default: dev.
E2E_TARGET=https://dev.naisi.uk

# The project every resource lands in. Asserted against a hard-coded literal.
FIREBASE_ADMIN_PROJECT_ID=naisi-uk-dev

# Web API key of that project. Public by design (it is inlined into the client
# bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME

# OPTIONAL, default off, and normally NEVER edited: `npm run e2e:local` arms
# the /api/register batteries itself, via the process environment, after
# starting the captcha-relaxed loopback server and Mailpit they need. The file
# switch exists only for hand-driven debugging against a server you started
# yourself. Read the header of tests/register-enumeration.test.mjs first.
E2E_ALLOW_REGISTER=0
